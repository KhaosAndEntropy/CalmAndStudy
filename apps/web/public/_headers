/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; font-src 'self' data:; img-src 'self' data:; media-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self'; upgrade-insecure-requests
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  Origin-Agent-Cluster: ?1
  Cache-Control: no-store, no-cache, must-revalidate
  ! Access-Control-Allow-Origin

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/images/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/favicon*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=3600
